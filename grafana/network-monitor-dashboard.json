    {
      "id": 5,
      "title": "Erreichbare Geräte im Verlauf",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": ""
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT s.checked AS \"time\", coalesce(sum(o.online),0) AS \"Erreichbare Geräte\"\nFROM scans s JOIN observations o ON o.scan_id=s.id\nWHERE o.ip='192.168.178.124' AND $__timeFilter(s.checked)\nGROUP BY s.id,s.checked ORDER BY s.checked,s.id;"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Anzahl erreichbarer Geräte pro Scan, ausschließlich 192.168.178.124: 1 = online, 0 = offline."
    },
    {
      "id": 6,
      "title": "Latenz – 192.168.178.124",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
